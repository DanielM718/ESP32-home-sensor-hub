[Unit]
Description=Home Sensor Flask Dashboard
Documentation=file:/opt/home-sensor/server/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target influxdb.service
Wants=home-sensor-export-worker.service

[Service]
Type=exec
User=home-sensor
Group=home-sensor
WorkingDirectory=/opt/home-sensor/server/backend
EnvironmentFile=/opt/home-sensor/server/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/home-sensor/server/scripts/wait_for_influxdb.sh
ExecStart=/opt/home-sensor/server/backend/.venv/bin/gunicorn --workers ${GUNICORN_WORKERS} --timeout 70 --bind ${FLASK_HOST}:${FLASK_PORT} app.web:create_app()
Restart=on-failure
RestartSec=10s
TimeoutStartSec=70s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/home-sensor

[Install]
WantedBy=multi-user.target
