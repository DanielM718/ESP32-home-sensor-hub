        "name": "Print starts and ends",
        "target": {
          "query": "sessions = from(bucket: \"environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"print_session\")\n  |> filter(fn: (r) => r._field == \"session_id\" or r._field == \"job_name\" or r._field == \"ended_at\" or r._field == \"result\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nstarts = sessions |> map(fn: (r) => ({_time: r._time, text: \"Print started\", tags: \"printer,x2d,start\"}))\nends = sessions\n  |> filter(fn: (r) => exists r.ended_at)\n  |> map(fn: (r) => ({_time: time(v: r.ended_at), text: \"Print ended\", tags: \"printer,x2d,end\"}))\nunion(tables: [starts, ends])",
          "refId": "PrintSessions"
        }
      }
    ]
  },
