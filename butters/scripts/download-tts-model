#!/bin/sh
set -eu

model="vits-piper-en_US-kathleen-low"
url="https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/$model.tar.bz2"
sha256="3dd0adaf077e19de32876608c3ac3d4a0a46a6f06310cc7a5633b3b47d762cde"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
butters_dir=$(dirname -- "$script_dir")
destination="${1:-$butters_dir/models/$model}"

complete=true
for filename in en_US-kathleen-low.onnx tokens.txt MODEL_CARD; do
    if [ ! -f "$destination/$filename" ]; then
        complete=false
    fi
done
if [ "$complete" = true ]; then
    echo "model already installed: $destination"
    exit 0
fi
if [ -e "$destination" ]; then
    echo "error: incomplete destination already exists: $destination" >&2
    exit 2
fi

temporary=$(mktemp -d "${TMPDIR:-/tmp}/butters-tts-model.XXXXXX")
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM
archive="$temporary/$model.tar.bz2"

echo "downloading $url"
curl --fail --location --output "$archive" "$url"
printf '%s  %s\n' "$sha256" "$archive" | sha256sum --check --status -

mkdir -p "$temporary/extracted"
tar -xjf "$archive" -C "$temporary/extracted"
mkdir -p "$(dirname -- "$destination")"
mv "$temporary/extracted/$model" "$destination"
echo "installed Piper-compatible Kathleen voice: $destination"
