#!/usr/bin/env bash
# Stage, verify, then atomically swap. A failure before the swap leaves the
# previously installed tree untouched, and the replaced tree is retained as
# /opt/butters.previous for rollback.
set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
butters_dir="$(dirname "${script_dir}")"
install_dir="/opt/butters"
staging_dir="/opt/butters.staging.$$"
previous_dir="/opt/butters.previous"
state_dir="/var/lib/butters"
config_dir="/etc/butters"
unit_name="butters-web.service"
enable_service=0
start_service=0

usage() {
  echo "Usage: sudo ./butters/scripts/install-beta1 [--enable] [--start]"
}

cleanup() {
  rm -rf "${staging_dir}"
}

# Seal a staged tree for the unprivileged service user. rsync -a faithfully
# reproduces the checkout's private modes (0700 directories, 0600 files), which
# root can read but `butters` cannot, so ownership and modes must both be reset
# before the tree is published. Existing executable bits are preserved so the
# interpreter, helper scripts, and native libraries stay runnable; everything
# else becomes read-only data. Nothing is world-accessible or group-writable.
normalize_application_tree() {
  local root="$1" owner="$2" group="$3"
  # -h changes a symlink's own ownership and never follows it out of the tree:
  # .venv/bin/python3 points at /usr/bin/python3.
  chown -h -R "${owner}:${group}" "${root}"
  # -type d and -type f never match symlinks, so link targets are untouched here
  # too. Leading zeroes also clear any setuid/setgid/sticky bit.
  find "${root}" -type d -exec chmod 0750 {} +
  find "${root}" -type f -perm /111 -exec chmod 0750 {} +
  find "${root}" -type f ! -perm /111 -exec chmod 0640 {} +
}

# Sourcing this file defines the helpers without performing an installation, so
# the regression tests can exercise normalize_application_tree() directly.
(return 0 2>/dev/null) && return 0

trap cleanup EXIT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable) enable_service=1 ;;
    --start) enable_service=1; start_service=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this installer with sudo." >&2
  exit 2
fi
command -v rsync >/dev/null || { echo "rsync is required" >&2; exit 2; }
[[ -x "${butters_dir}/.venv/bin/python" ]] || { echo "Butters .venv is missing" >&2; exit 2; }
[[ -d "${butters_dir}/models" ]] || { echo "Butters local models are missing" >&2; exit 2; }

# A production install must never ship the development authorization bypass.
if grep -Eq '^[[:space:]]*development_mode[[:space:]]*=[[:space:]]*true' \
    "${butters_dir}/config/assistant.toml"; then
  echo "Refusing to install: config/assistant.toml sets development_mode = true" >&2
  exit 2
fi

if ! getent group butters >/dev/null; then
  groupadd --system butters
fi
if ! id butters >/dev/null 2>&1; then
  useradd --system --gid butters --home-dir "${state_dir}" --shell /usr/sbin/nologin butters
fi

install -d -m 0700 -o butters -g butters "${state_dir}" "${state_dir}/codex-jobs"
install -d -m 0750 -o root -g butters "${config_dir}"

# 1. Stage a complete tree next to the target.
rm -rf "${staging_dir}"
install -d -m 0755 -o root -g root "${staging_dir}"
rsync -a --delete \
  --exclude runtime \
  --exclude models/llm \
  --exclude models/sherpa-onnx-streaming-zipformer-en-20M-2023-02-17 \
  --exclude __pycache__ \
  --exclude '*.pyc' \
  "${butters_dir}/" "${staging_dir}/"

# 2. Verify the staged tree before it can ever be executed. Byte-compiling
#    writes __pycache__ into the staging tree, so it has to finish before the
#    tree is sealed in step 3.
"${staging_dir}/.venv/bin/python" -m compileall -q "${staging_dir}/src" >/dev/null \
  || { echo "Staged tree failed to compile; nothing was replaced." >&2; exit 3; }
[[ -f "${staging_dir}/src/butters/web/app.py" ]] \
  || { echo "Staged tree is incomplete; nothing was replaced." >&2; exit 3; }

# 3. Seal the staged tree. This is the last write to it, so the swap below
#    publishes an already-correct tree and /opt/butters is never momentarily
#    unreadable by the service user.
normalize_application_tree "${staging_dir}" root butters

# 4. Swap. Renames are atomic, so no mixed tree is ever importable, and the
#    replaced tree is kept for rollback.
if [[ -d "${install_dir}" ]]; then
  rm -rf "${previous_dir}"
  mv "${install_dir}" "${previous_dir}"
fi
mv "${staging_dir}" "${install_dir}"

if [[ ! -e "${config_dir}/butters.env" ]]; then
  install -m 0640 -o root -g butters "${butters_dir}/config/butters.env.example" "${config_dir}/butters.env"
fi
chown root:butters "${config_dir}/butters.env"
chmod 0640 "${config_dir}/butters.env"

# Non-secret deployment values. BUTTERS_ALLOWED_ORIGINS is required before the
# daemon will issue sessions or accept mutations in production; the private
# Tailscale HTTPS origin is only known after `tailscale serve` has been run.
if [[ ! -e "${config_dir}/butters.conf" ]]; then
  install -m 0640 -o root -g butters /dev/null "${config_dir}/butters.conf"
  cat >"${config_dir}/butters.conf" <<'CONF'
# Exact private Tailscale HTTPS origin, e.g.
# BUTTERS_ALLOWED_ORIGINS=https://pi.tailnet-name.ts.net
BUTTERS_ALLOWED_ORIGINS=

# Optional. Only set this to a repository that is deliberately readable by the
# butters service user. Leave it empty on an ordinary deployment; repository
# inspection then reports repository_unavailable instead of reaching into a
# private home directory.
# BUTTERS_PROJECT_INSPECTION_ROOT=
CONF
  chown root:butters "${config_dir}/butters.conf"
  chmod 0640 "${config_dir}/butters.conf"
fi

install -m 0644 -o root -g root "${butters_dir}/systemd/${unit_name}" "/etc/systemd/system/${unit_name}"

systemctl daemon-reload
if [[ "${enable_service}" == "1" ]]; then
  systemctl enable "${unit_name}"
fi
if [[ "${start_service}" == "1" ]]; then
  systemctl restart "${unit_name}"
fi

echo "Installed Butters Beta 1 at ${install_dir}."
echo "Application tree: ${install_dir} (root:butters, 0750 directories, 0640 files)."
echo "Rollback tree: ${previous_dir} (mv it back over ${install_dir}, then restart)."
echo "Secrets: ${config_dir}/butters.env (root:butters 0640)."
echo "Deployment values: ${config_dir}/butters.conf (set BUTTERS_ALLOWED_ORIGINS)."
echo "State: ${state_dir} (butters:butters 0700)."
